let
  keys = {
    main = "";
  };
in
  with builtins;
    [
      "modules/jai"
    ]
    |> map (
      dir:
        readDir (./. + "/${dir}")
        |> attrNames
        |> map (name: "${dir}/${name}")
    )
    |> concatLists
    |> filter (path: match ".*\\.age$" path != null)
    |> map (path: {
      name = path;
      value.publicKeys = [keys.main];
    })
    |> listToAttrs
