+/// list immediate children as (path, is_directory) pairs
+/// git ignore rules are optional and dotfiles remain visible
+fn directory_entries(
+    directory: SteelString,
+    respect_gitignore: bool,
+) -> steel::rvals::Result<Vec<(String, bool)>> {
+    if !std::fs::metadata(directory.as_str())?.is_dir() {
+        steel::stop!(Io => "directory-entries expected a directory: {}", directory);
+    }
+
+    let mut entries = Vec::new();
+    for entry in ignore::WalkBuilder::new(directory.as_str())
+        .standard_filters(false)
+        .parents(true)
+        .git_ignore(respect_gitignore)
+        .git_global(respect_gitignore)
+        .git_exclude(respect_gitignore)
+        .follow_links(false)
+        .max_depth(Some(1))
+        .build()
+    {
+        let entry = entry.map_err(|error| SteelErr::new(ErrorKind::Io, error.to_string()))?;
+        if let Some(error) = entry.error() {
+            return Err(SteelErr::new(ErrorKind::Io, error.to_string()));
+        }
+        if entry.depth() == 0 {
+            continue;
+        }
+        let Some(kind) = entry.file_type() else {
+            continue;
+        };
+        let kind = if kind.is_symlink() {
+            match entry.path().metadata() {
+                Ok(metadata) => metadata.file_type(),
+                Err(_) => continue,
+            }
+        } else {
+            kind
+        };
+        if !kind.is_dir() && !kind.is_file() {
+            continue;
+        }
+        let path = entry.path().to_str().ok_or_else(|| {
+            SteelErr::new(
+                ErrorKind::Io,
+                format!("non unicode path: {}", entry.path().display()),
+            )
+        })?;
+        entries.push((path.to_owned(), kind.is_dir()));
+    }
+    Ok(entries)
+}
