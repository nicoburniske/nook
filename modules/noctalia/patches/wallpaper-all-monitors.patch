@@ -2223,6 +2223,13 @@
       m_defaultWallpaperPath = path;
       changed = true;
     }
+    auto* wallpaperTbl = ensureTable(m_overridesTable, "wallpaper");
+    auto* monitorsTbl = ensureTable(*wallpaperTbl, "monitors");
